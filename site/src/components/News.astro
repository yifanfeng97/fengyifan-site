---
import SectionHead from './SectionHead.astro';
import { news } from '../data/news';
import { sections, t, type Lang } from '../data/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const sec = sections.news;

const VISIBLE_COUNT = 6;

// Group items by year (derived from the English date label, e.g. "Jun. 2026").
const groups: { year: string; items: typeof news }[] = [];
for (const item of news) {
  const year = String(t(item.date, 'en')).slice(-4);
  const g = groups[groups.length - 1];
  if (g && g.year === year) g.items.push(item);
  else groups.push({ year, items: [item] });
}

let idx = -1;
---

<section id={sec.id}>
  <SectionHead title={sec.title} hint={sec.hint} lang={lang} />

  <div class="news" data-collapsed>
    {groups.map((g) => {
      const groupStart = idx + 1;
      return (
        <div class:list={['news-year', { 'year-extra': groupStart >= VISIBLE_COUNT }]}>
          <div class="year-label">{g.year}</div>
          <div class="year-items">
            {g.items.map((item) => {
              idx += 1;
              return (
                <div class:list={['news-item', { 'news-extra': idx >= VISIBLE_COUNT }]}>
                  <span class="news-date">{t(item.date, lang)}</span>
                  <span class="news-text" set:html={item.html[lang]} />
                  {item.badge && <span class="news-badge">{t(item.badge, lang)}</span>}
                </div>
              );
            })}
          </div>
        </div>
      );
    })}

    <button class="news-toggle" type="button" aria-expanded="false">
      <span class="more">{t(sections.newsMore, lang)} ({news.length}) ↓</span>
      <span class="less">{t(sections.newsLess, lang)} ↑</span>
    </button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.news[data-collapsed]').forEach((el) => {
    const btn = el.querySelector('.news-toggle');
    btn?.addEventListener('click', () => {
      const collapsed = el.hasAttribute('data-collapsed');
      el.toggleAttribute('data-collapsed', !collapsed);
      btn.setAttribute('aria-expanded', String(collapsed));
    });
  });
</script>

<style>
  /* ---------- year-grouped news list (no card chrome) ---------- */
  .news-year {
    display: grid; grid-template-columns: 88px 1fr; gap: 8px 26px;
    padding: 18px 0 6px;
  }
  .news-year + .news-year { border-top: 1px solid rgba(124, 58, 237, .18); }
  .year-label {
    font-family: var(--serif); font-size: 26px; font-weight: 700;
    color: var(--gold); line-height: 1.2; letter-spacing: .02em;
    padding-top: 2px; user-select: none;
  }

  .year-items { display: flex; flex-direction: column; }
  .news-item {
    display: flex; align-items: baseline; gap: 16px;
    padding: 10px 4px;
    border-bottom: 1px solid rgba(124, 58, 237, .1);
  }
  .news-item:last-child { border-bottom: none; }
  .news-date {
    flex: 0 0 74px;
    font-family: var(--mono); font-size: 12.5px; color: var(--gold);
    letter-spacing: .03em; opacity: .85;
  }
  .news-text { font-size: 14px; line-height: 1.65; color: #D5CDE6; }
  .news-text :global(.hl) { color: #fff; font-weight: 600; }
  .news-text :global(a) {
    color: var(--gold-bright); text-decoration: none;
    border-bottom: 1px dashed rgba(212, 175, 106, .35);
    transition: color .2s, border-color .2s;
  }
  .news-text :global(a:hover) { color: #fff; border-color: #fff; }
  .news-badge {
    margin-left: auto; flex: 0 0 auto;
    font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--gold-bright); border: 1px solid rgba(212, 175, 106, .45);
    border-radius: 999px; padding: 2px 9px; background: rgba(212, 175, 106, .08);
  }

  /* ---------- expand / collapse ---------- */
  .news-extra { display: none; }
  .news:not([data-collapsed]) .news-extra { display: flex; animation: news-in .35s ease; }
  /* Hide year groups whose every item is collapsed (no orphan year labels). */
  .news[data-collapsed] .news-year.year-extra { display: none; }
  .news:not([data-collapsed]) .news-year.year-extra { animation: news-in .35s ease; }
  @keyframes news-in { from { opacity: 0; } to { opacity: 1; } }

  .news-toggle {
    display: block; margin: 20px auto 0;
    font-family: var(--serif); font-size: 14px; font-weight: 700; letter-spacing: .06em;
    color: var(--gold-bright); cursor: pointer;
    border: 1px solid rgba(212, 175, 106, .45); border-radius: 999px;
    padding: 9px 24px; background: rgba(212, 175, 106, .06);
    transition: background .25s ease, box-shadow .25s ease;
  }
  .news-toggle:hover {
    background: rgba(212, 175, 106, .14);
    box-shadow: 0 0 18px rgba(212, 175, 106, .25);
  }
  .news-toggle .less { display: none; }
  .news:not([data-collapsed]) .news-toggle .more { display: none; }
  .news:not([data-collapsed]) .news-toggle .less { display: inline; }

  @media (max-width: 820px) {
    .news-year { grid-template-columns: 1fr; gap: 2px; padding: 14px 0 4px; }
    .year-label { font-size: 20px; }
    .news-item { flex-wrap: wrap; gap: 4px 14px; }
    .news-date { flex-basis: 100%; }
    .news-badge { margin-left: 0; }
  }
</style>
