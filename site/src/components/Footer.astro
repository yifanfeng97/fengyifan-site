---
import { profile } from '../data/profile';
import { t, type Lang } from '../data/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer>
  <div>{t(profile.copyright, lang)}</div>
</footer>

<style>
  /* ---------- footer ---------- */
  footer {
    padding: 34px 0 40px;
    text-align: center; color: var(--faint); font-size: 12.5px; letter-spacing: .06em;
  }
</style>
