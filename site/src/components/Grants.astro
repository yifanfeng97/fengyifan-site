---
import SectionHead from './SectionHead.astro';
import { grants } from '../data/grants';
import { sections, t, type Lang } from '../data/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const sec = sections.grants;
---

<section id={sec.id}>
  <SectionHead title={sec.title} hint={sec.hint} lang={lang} />

  <div class="grant-rows">
    {grants.map((item) => (
      <div class="grant-row">
        <span class="grant-years">{item.years}</span>
        <span class="grant-name">{t(item.name, lang)}</span>
        <span class="grant-role">{t(item.role, lang)}</span>
      </div>
    ))}
  </div>
</section>

<style>
  /* ---------- compact plain-text grants list ---------- */
  .grant-rows { max-width: 940px; }
  .grant-row {
    display: flex; align-items: baseline; gap: 14px;
    padding: 10px 2px;
    border-bottom: 1px solid rgba(124, 58, 237, .15);
    transition: border-color .25s ease;
  }
  .grant-row:last-child { border-bottom: none; }
  .grant-row:hover { border-bottom-color: rgba(212, 175, 106, .4); }
  .grant-years {
    flex: 0 0 120px;
    font-family: var(--mono); font-size: 12.5px; color: var(--gold); letter-spacing: .03em;
  }
  .grant-name { font-size: 13.5px; line-height: 1.6; color: #D5CDE6; }
  .grant-role {
    margin-left: auto; flex: 0 0 auto;
    font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: #C9B8F0; border: 1px solid rgba(124, 58, 237, .45);
    border-radius: 999px; padding: 2px 9px; background: rgba(124, 58, 237, .1);
  }

  @media (max-width: 820px) {
    .grant-row { flex-wrap: wrap; gap: 4px 14px; }
    .grant-years { flex-basis: 100%; }
    .grant-role { margin-left: 0; }
  }
</style>
