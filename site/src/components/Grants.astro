---
import SectionHead from './SectionHead.astro';
import { grants } from '../data/grants';
import { sections, t, type Lang } from '../data/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const sec = sections.grants;
---

<section id={sec.id}>
  <SectionHead title={sec.title} hint={sec.hint} lang={lang} />

  <div class="grant-rows">
    {grants.map((item) => (
      <div class="grant-row">
        <span class="grant-years">{item.years}</span>
        <span class="grant-main">
          <span class="grant-name">{t(item.name, lang)}</span>
          <span class="grant-title">{t(item.title, lang)}</span>
        </span>
        <span class="grant-fund">{t(item.fund, lang)}</span>
        <span class="grant-role">{t(item.role, lang)}</span>
      </div>
    ))}
  </div>
</section>

<style>
  /* ---------- grant rows as subtle cards, right edge aligned with the pub list ---------- */
  .grant-rows { display: flex; flex-direction: column; gap: 10px; }
  .grant-row {
    display: flex; align-items: center; gap: 16px;
    padding: 14px 18px;
    background: var(--card-2);
    border: 1px solid rgba(124, 58, 237, .18);
    border-radius: 12px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, .3);
    transition: border-color .25s ease, box-shadow .25s ease;
  }
  .grant-row:hover {
    border-color: rgba(212, 175, 106, .4);
    box-shadow: 0 6px 20px rgba(0, 0, 0, .45), 0 0 16px rgba(124, 58, 237, .18);
  }
  .grant-years {
    flex: 0 0 108px;
    font-family: var(--mono); font-size: 12.5px; color: var(--gold); letter-spacing: .03em;
  }
  .grant-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .grant-name { font-size: 13.5px; font-weight: 600; line-height: 1.6; color: #EFE9F8; }
  .grant-title { font-size: 12px; line-height: 1.55; color: var(--faint); }
  .grant-fund {
    margin-left: auto; flex: 0 0 76px; text-align: right;
    font-family: var(--mono); font-size: 12.5px; color: var(--gold); letter-spacing: .04em;
  }
  .grant-role {
    flex: 0 0 auto;
    font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--gold-bright); border: 1px solid rgba(212, 175, 106, .45);
    border-radius: 999px; padding: 2px 9px; background: rgba(212, 175, 106, .08);
  }

  @media (max-width: 820px) {
    .grant-row { flex-wrap: wrap; gap: 6px 14px; }
    .grant-years { flex-basis: 100%; }
    .grant-fund { margin-left: 0; flex-basis: auto; text-align: left; }
  }
</style>
