---
import { sections, type Lang } from '../data/ui';
import visitors from '../data/visitors.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isZh = lang === 'zh';

// 展示用名称映射：键为 visitors.json 里的英文名（沿用 Clarity Country/Region）。
// 未列出的新来源直接回退为英文名。
const ZH_NAMES: Record<string, string> = {
  China: '中国',
  'Hong Kong': '中国香港',
  Taiwan: '中国台湾',
  'United States of America': '美国',
  Singapore: '新加坡',
  Japan: '日本',
  'United Kingdom': '英国',
  Germany: '德国',
  'South Korea': '韩国',
  Canada: '加拿大',
  Australia: '澳大利亚',
  France: '法国',
  India: '印度',
  Netherlands: '荷兰',
  Switzerland: '瑞士',
  Italy: '意大利',
  Sweden: '瑞典',
  Spain: '西班牙',
  Israel: '以色列',
  Denmark: '丹麦',
  Belgium: '比利时',
  Austria: '奥地利',
  Brazil: '巴西',
  Russia: '俄罗斯',
  Finland: '芬兰',
  Ireland: '爱尔兰',
  Poland: '波兰',
  'New Zealand': '新西兰',
  Norway: '挪威',
};
const EN_NAMES: Record<string, string> = {
  'United States of America': 'United States',
  'Hong Kong': 'Hong Kong, China',
  Taiwan: 'Taiwan, China',
};

const entries = Object.entries(visitors as Record<string, number>).sort((a, b) => b[1] - a[1]);
const total = entries.reduce((s, [, v]) => s + v, 0);
const shown = entries.slice(0, 15);

const nameOf = (key: string) => (isZh ? (ZH_NAMES[key] ?? key) : (EN_NAMES[key] ?? key));
const fmt = (n: number) => n.toLocaleString('en-US');
---

{entries.length > 0 && (
  <section id={sections.visitors.id}>
    <div class="v-head">
      <span class="rule"></span>
      <span class="src">{sections.visitors.hint}</span>
    </div>
    <div class="v-total">
      <span class="num">{fmt(total)}</span>
      <span class="cap">
        {isZh ? `总访问量 · ${entries.length} 个国家/地区` : `Total visits · ${entries.length} countries/regions`}
      </span>
      <span class="note">{isZh ? '数据每 4 小时更新一次' : 'Updated every 4 hours'}</span>
    </div>
    <div class="v-pills">
      {shown.map(([key, v]) => (
        <span class="v-pill">
          <span class="nm">{nameOf(key)}</span>
          <span class="vl">{fmt(v)}</span>
        </span>
      ))}
    </div>
  </section>
)}

<style>
  /* 主页最后一个区块，底部多留些空间再进 footer */
  section { padding-bottom: 48px; }
  .v-head {
    display: flex; align-items: center; gap: 16px;
    margin-bottom: 28px;
  }
  .v-head .rule {
    flex: 1; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(212, 175, 106, .35), rgba(124, 58, 237, .55));
  }
  .v-head .src {
    font-family: var(--serif); font-style: italic;
    font-size: 13px; color: var(--faint);
    letter-spacing: .1em; white-space: nowrap;
  }
  .v-total {
    text-align: center; margin-bottom: 28px;
  }
  .v-total .num {
    display: block;
    font-family: var(--serif);
    font-size: 42px; line-height: 1.1;
    color: var(--gold-bright);
    font-variant-numeric: lining-nums;
  }
  .v-total .cap {
    display: block; margin-top: 6px;
    color: var(--muted); font-size: 13px;
  }
  .v-total .note {
    display: block; margin-top: 4px;
    color: var(--faint); font-size: 11.5px;
  }
  .v-pills {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 11px 12px;
  }
  .v-pill {
    display: inline-flex; align-items: baseline; gap: 8px;
    border: 1px solid rgba(154, 144, 176, .28);
    border-radius: 999px;
    padding: 7px 17px;
    background: rgba(124, 58, 237, .06);
  }
  .v-pill .nm { font-size: 14.5px; }
  .v-pill .vl {
    font-size: 12.5px; color: var(--muted);
    font-variant-numeric: lining-nums;
  }
  @media (max-width: 720px) {
    .v-total .num { font-size: 34px; }
    .v-pill { padding: 6px 13px; }
    .v-pill .nm { font-size: 13.5px; }
  }
</style>
